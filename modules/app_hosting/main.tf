# The smogcast app (Reflex; repo smog-cast-app) on Azure Container Apps.
#
#   ghcr.io (public image) ──► Container App: 1 vCPU / 2 GiB, exactly one replica, HTTPS + websockets on port 3000
#   Container App ──its managed identity──► Key Vault: the two secrets below, read by the platform at start
#   Container App ──service principal, OAuth──► SQL Warehouse ──► <catalog>.gold_secure, as an analyst
#   GitHub Actions (deploy.yml of the app repo) ──OIDC──► deploy identity ──► a new image on this one app
#
# Secret VALUES are never here (they would land in the state). Terraform knows two NAMES in Key Vault:
#   app-databricks-client-secret  the OAuth secret of the app's service principal, generated by hand in the workspace
#   app-llm-api-key               the key of the language model
# Both are set with `az keyvault secret set` BEFORE the app exists: the platform resolves them when it creates it.
# Hence two applies: the first with image = null (identities, principal, environment), then the secrets and the
# image by hand, then the second apply with the image set (README §6d).

terraform {
  required_providers {
    azurerm = { source = "hashicorp/azurerm" }
    databricks = {
      source                = "databricks/databricks"
      configuration_aliases = [databricks.account]
    }
  }
}

locals {
  name = "smogcast-app-${var.environment}"
}

# ----------------------------------------------------------------------------- who the app is in Databricks
# A Databricks-managed principal of its own – not the Jobs' principal, which may write the whole catalog. The app
# signs in with the principal's id and an OAuth secret (OAuth machine to machine, what the SQL connector documents).
resource "databricks_service_principal" "app" {
  display_name          = "sp-${local.name}"
  databricks_sql_access = true # may use SQL Warehouses; no notebooks, no clusters
}

# The role: analyst. The group already has USE_CATALOG and SELECT on gold_secure (module governance), and the secure
# views show its members every row with the technical columns masked. The warehouse needs no grant of its own: the
# workspace group `users` has CAN_USE on it, and a databricks_permissions resource would replace that whole list.
resource "databricks_group_member" "analyst" {
  provider  = databricks.account
  group_id  = var.analysts_group_id
  member_id = databricks_service_principal.app.id
}

# ----------------------------------------------------------------------------- who the app is in Azure
# User-assigned, so it exists (and can read the vault) before the app does; a system-assigned identity is born with
# the app, too late for the secrets the app needs to be created.
resource "azurerm_user_assigned_identity" "app" {
  name                = "id-${local.name}"
  resource_group_name = var.resource_group_name
  location            = var.location
  tags                = var.tags
}

# ----------------------------------------------------------------------------- where it runs
resource "azurerm_log_analytics_workspace" "this" {
  name                = "log-${local.name}"
  resource_group_name = var.resource_group_name
  location            = var.location
  sku                 = "PerGB2018"
  retention_in_days   = 30
  tags                = var.tags
}

# Its region may differ from the rest (var.environment_location): a region can be out of capacity for new
# environments, and the app itself takes the region of its environment. Identities, logs and the vault stay put.
resource "azurerm_container_app_environment" "this" {
  name                       = "cae-${local.name}"
  resource_group_name        = var.resource_group_name
  location                   = coalesce(var.environment_location, var.location)
  logs_destination           = "log-analytics"
  log_analytics_workspace_id = azurerm_log_analytics_workspace.this.id
  tags                       = var.tags

  # Pay per use, nothing reserved. Declared at creation: an environment made without profiles can never get one.
  workload_profile {
    name                  = "Consumption"
    workload_profile_type = "Consumption"
  }
}

resource "azurerm_container_app" "this" {
  count                        = var.image == null ? 0 : 1
  name                         = "ca-${local.name}"
  resource_group_name          = var.resource_group_name
  container_app_environment_id = azurerm_container_app_environment.this.id
  workload_profile_name        = "Consumption"
  revision_mode                = "Single" # a new image replaces the running one
  tags                         = var.tags

  identity {
    type         = "UserAssigned"
    identity_ids = [azurerm_user_assigned_identity.app.id]
  }

  # Key Vault references without a version: the platform reads the current value when a revision starts.
  secret {
    name                = "databricks-client-secret"
    key_vault_secret_id = "${var.key_vault_uri}secrets/${var.databricks_client_secret_name}"
    identity            = azurerm_user_assigned_identity.app.id
  }

  secret {
    name                = "llm-api-key"
    key_vault_secret_id = "${var.key_vault_uri}secrets/${var.llm_api_key_secret_name}"
    identity            = azurerm_user_assigned_identity.app.id
  }

  # One port for the pages and the websocket (reflex run --env prod --single-port); HTTPS comes from the platform.
  ingress {
    external_enabled = true
    target_port      = 3000
    transport        = "auto"

    traffic_weight {
      latest_revision = true
      percentage      = 100
    }
  }

  template {
    # Exactly one: the conversations live in the memory of the process, and it never scales to zero (no cold start).
    min_replicas = 1
    max_replicas = 1

    container {
      name   = "app"
      image  = var.image
      cpu    = var.cpu
      memory = var.memory

      env {
        name  = "DATABRICKS_HOST"
        value = var.databricks_host
      }
      env {
        name  = "DATABRICKS_WAREHOUSE_ID"
        value = var.sql_warehouse_id
      }
      env {
        name  = "DATABRICKS_CLIENT_ID"
        value = databricks_service_principal.app.application_id
      }
      env {
        name        = "DATABRICKS_CLIENT_SECRET"
        secret_name = "databricks-client-secret"
      }
      env {
        name  = "SMOGCAST_CATALOG"
        value = var.catalog_name
      }
      env {
        name  = "SMOGCAST_DATA"
        value = "warehouse" # the image has no saved copy of the data to fall back on
      }
      env {
        name  = "SMOGCAST_LLM_BASE_URL"
        value = var.llm_base_url
      }
      env {
        name  = "SMOGCAST_LLM_MODEL"
        value = var.llm_model
      }
      env {
        name        = "SMOGCAST_LLM_API_KEY"
        secret_name = "llm-api-key"
      }
    }
  }

  lifecycle {
    # var.image is the first deployment only; from then on deploy.yml of the app repo sets the image.
    ignore_changes = [template[0].container[0].image]
  }

  depends_on = [databricks_group_member.analyst]
}

# ----------------------------------------------------------------------------- who may deploy it
# GitHub Actions of the app repo signs in as this identity through OIDC (no secret anywhere). A separate identity:
# not the app's (it reads the secrets) and not the Jobs' principal (it writes the catalog).
resource "azurerm_user_assigned_identity" "deploy" {
  name                = "id-${local.name}-deploy"
  resource_group_name = var.resource_group_name
  location            = var.location
  tags                = var.tags
}

resource "azurerm_federated_identity_credential" "github" {
  for_each                  = var.github_subjects
  name                      = each.key
  user_assigned_identity_id = azurerm_user_assigned_identity.deploy.id
  audience                  = ["api://AzureADTokenExchange"]
  issuer                    = "https://token.actions.githubusercontent.com"
  subject                   = each.value
}

# `az containerapp update --image …` on this one app – no rights on the subscription or on other resources.
resource "azurerm_role_assignment" "deploy_app" {
  count                = var.image == null ? 0 : 1
  scope                = azurerm_container_app.this[0].id
  role_definition_name = "Container Apps Contributor"
  principal_id         = azurerm_user_assigned_identity.deploy.principal_id
}

# An update of the app names its environment, and Azure asks for "join" on it. On the environment this role is no
# more than that: read and join (its write actions are about container apps, and none live under this scope).
resource "azurerm_role_assignment" "deploy_environment" {
  scope                = azurerm_container_app_environment.this.id
  role_definition_name = "Container Apps Contributor"
  principal_id         = azurerm_user_assigned_identity.deploy.principal_id
}
