variable "environment" {
  description = "Environment name (dev | prod); part of every resource name"
  type        = string
}

variable "location" {
  type = string
}

variable "resource_group_name" {
  type = string
}

variable "environment_location" {
  description = "Azure region of the Container Apps environment and the app in it; null = var.location. Set another region when this one has no capacity for new environments"
  type        = string
  default     = null
}

variable "image" {
  description = "Image of the FIRST deployment, e.g. ghcr.io/<owner>/smog-cast-app:<tag>. null = no app yet (everything around it is created). Later images are set by deploy.yml of the app repo and ignored here"
  type        = string
  default     = null
}

variable "cpu" {
  description = "vCPU of the container; with memory it must be one of the Consumption combinations (0.25/0.5Gi … 2/4Gi)"
  type        = number
  default     = 1
}

variable "memory" {
  description = "Memory of the container; the app with PyTorch and the embedding model takes about 1 GiB"
  type        = string
  default     = "2Gi"
}

variable "key_vault_uri" {
  description = "URI of the Key Vault that holds the app's two secrets (https://<name>.vault.azure.net/)"
  type        = string
}

variable "databricks_client_secret_name" {
  description = "Key Vault secret with the OAuth secret of the app's service principal (generated by hand in the workspace, set with az keyvault secret set)"
  type        = string
  default     = "app-databricks-client-secret"
}

variable "llm_api_key_secret_name" {
  description = "Key Vault secret with the key of the language model (set with az keyvault secret set)"
  type        = string
  default     = "app-llm-api-key"
}

variable "databricks_host" {
  description = "Workspace URL the app reads from"
  type        = string
}

variable "sql_warehouse_id" {
  description = "SQL Warehouse the app queries"
  type        = string
}

variable "catalog_name" {
  description = "Catalog of the environment; the app reads <catalog>.gold_secure"
  type        = string
}

variable "analysts_group_id" {
  description = "Id of the account group whose members read gold_secure as analysts (module governance)"
  type        = string
}

variable "llm_base_url" {
  description = "OpenAI-compatible endpoint of the language model"
  type        = string
}

variable "llm_model" {
  description = "Language model name"
  type        = string
}

variable "github_subjects" {
  description = "Credential name => GitHub OIDC subject allowed to deploy the app, e.g. { gh-dev = \"repo:<owner>/smog-cast-app:environment:dev\" }"
  type        = map(string)
  default     = {}
}

variable "tags" {
  type    = map(string)
  default = {}
}
