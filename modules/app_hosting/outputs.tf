output "url" {
  description = "Public address of the app; null until the app exists (image = null)"
  value       = try("https://${azurerm_container_app.this[0].ingress[0].fqdn}", null)
}

output "container_app_name" {
  description = "CONTAINER_APP_NAME in the GitHub Environment of the app repo; null until the app exists"
  value       = try(azurerm_container_app.this[0].name, null)
}

output "identity_principal_id" {
  description = "Object id of the app's managed identity – the Key Vault lets it read secrets (module secrets)"
  value       = azurerm_user_assigned_identity.app.principal_id
}

output "service_principal_application_id" {
  description = "Client id of the app's Databricks service principal (DATABRICKS_CLIENT_ID); its OAuth secret is generated by hand"
  value       = databricks_service_principal.app.application_id
}

output "service_principal_name" {
  description = "Display name of the app's Databricks service principal – where to generate the OAuth secret"
  value       = databricks_service_principal.app.display_name
}

output "deploy_client_id" {
  description = "AZURE_CLIENT_ID in the GitHub Environment of the app repo (the deploy identity, signed in through OIDC)"
  value       = azurerm_user_assigned_identity.deploy.client_id
}
